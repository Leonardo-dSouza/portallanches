# Copie para .env.prod (ignorado pelo git) e troque os valores.
# Use só letras e números na senha do banco (ela vai dentro de uma URL).
POSTGRES_PASSWORD=troque-esta-senha
# Fuso em que o dia de negócio vira (meia-noite). Padrão: America/Sao_Paulo.
BUSINESS_TIMEZONE=America/Sao_Paulo
# Porta em que o sistema fica disponível na rede (pouco usada, para não colidir com outros serviços).
WEB_PORT=18480
# Porta do banco, só em 127.0.0.1 (backup e psql na própria máquina).
DB_PORT=15480
# Senhas iniciais dos usuários criados pelo seed (só na 1ª vez; depois troque pela tela/API).
SEED_ADMIN_PASSWORD=
SEED_CAIXA_PASSWORD=
