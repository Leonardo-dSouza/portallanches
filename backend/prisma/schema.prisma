// Modelo do Sprint 1 (fechamento de caixa diário). Ver docs/banco-de-dados.md.
// CHECK constraints (Prisma não expressa) ficam em SQL na migration:
//   - orders: type = 'COUNTER' => delivery_zone_id IS NULL AND delivery_fee = 0

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CAIXA
  ADMIN
}

enum OrderType {
  DELIVERY
  COUNTER
}

enum ClosingStatus {
  OPEN
  CLOSED
}

enum DayGroup {
  TUE_THU
  FRI_SUN
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  closedClosings   DailyClosing[]       @relation("ClosedBy")
  reopenedClosings DailyClosing[]       @relation("ReopenedBy")
  orders           Order[]
  expenses         Expense[]
  rateSettings     MotoboyRateSetting[]
  stockLots        StockLot[]
  stockMovements   StockMovement[]
  stockCounts      StockCount[]

  @@map("users")
}

model PaymentMethod {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("payment_methods")
}

model DeliveryZone {
  id              Int      @id @default(autoincrement())
  neighborhood    String
  // Chave normalizada (minúsculas, sem acento) gerada pela aplicação, para unicidade.
  neighborhoodKey String   @unique @map("neighborhood_key")
  fee             Decimal  @db.Decimal(10, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  orders    Order[]
  customers Customer[]

  @@map("delivery_zones")
}

model MotoboyRateSetting {
  id            Int      @id @default(autoincrement())
  dayGroup      DayGroup @map("day_group")
  amount        Decimal  @db.Decimal(10, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdById   Int      @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@unique([dayGroup, effectiveFrom])
  @@map("motoboy_rate_settings")
}

model DailyClosing {
  id               Int           @id @default(autoincrement())
  businessDate     DateTime      @unique @map("business_date") @db.Date
  status           ClosingStatus @default(OPEN)
  // Diária copiada na criação: editar a config depois não altera dias antigos.
  motoboyDailyRate Decimal       @map("motoboy_daily_rate") @db.Decimal(10, 2)
  closedById       Int?          @map("closed_by_id")
  closedAt         DateTime?     @map("closed_at") @db.Timestamptz
  reopenedById     Int?          @map("reopened_by_id")
  reopenedAt       DateTime?     @map("reopened_at") @db.Timestamptz
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  closedBy   User?     @relation("ClosedBy", fields: [closedById], references: [id])
  reopenedBy User?     @relation("ReopenedBy", fields: [reopenedById], references: [id])
  orders     Order[]
  expenses   Expense[]

  @@map("daily_closings")
}

model Order {
  id              Int        @id @default(autoincrement())
  closingId       Int        @map("closing_id")
  amount          Decimal    @db.Decimal(10, 2)
  // `type`, `paymentMethodId` e `deliveryFee` são nulos só em pedidos importados da planilha
  // histórica (ticket-medio-2026), que não registrava essa distinção. A aplicação sempre os preenche.
  type            OrderType?
  paymentMethodId Int?       @map("payment_method_id")
  deliveryZoneId  Int?       @map("delivery_zone_id")
  // Cópia da taxa da zona no lançamento; pode ser sobrescrita. 0 para balcão.
  deliveryFee     Decimal?   @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  // Cliente da entrega (obrigatório na aplicação só para DELIVERY). Nome, telefone e rua são
  // copiados no lançamento: mudar o cadastro do cliente não altera pedidos antigos.
  customerId      Int?       @map("customer_id")
  customerName    String?    @map("customer_name")
  customerPhone   String?    @map("customer_phone")
  customerStreet  String?    @map("customer_street")
  createdById     Int        @map("created_by_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  closing       DailyClosing   @relation(fields: [closingId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  deliveryZone  DeliveryZone?  @relation(fields: [deliveryZoneId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  createdBy     User           @relation(fields: [createdById], references: [id])

  @@index([closingId])
  @@index([paymentMethodId])
  @@index([customerId])
  @@map("orders")
}

/// Cliente de entrega. Um telefone = um cadastro (e uma rua); telefone é opcional
/// porque o pedido no papel às vezes não traz o número.
model Customer {
  id             Int      @id @default(autoincrement())
  name           String
  // Só dígitos (ex.: "79999991234"); único quando presente.
  phone          String?  @unique
  street         String
  deliveryZoneId Int      @map("delivery_zone_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  deliveryZone DeliveryZone @relation(fields: [deliveryZoneId], references: [id])
  orders       Order[]

  @@map("customers")
}

// Tipo de gasto parametrizável ("Gás", "Compra no Atacadão"...). Nada é apagado: `active: false`.
model ExpenseType {
  id        Int      @id @default(autoincrement())
  name      String
  // Mesma normalização do bairro (minúsculas, sem acento) para unicidade.
  nameKey   String   @unique @map("name_key")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@map("expense_types")
}

model Expense {
  id            Int      @id @default(autoincrement())
  closingId     Int      @map("closing_id")
  expenseTypeId Int      @map("expense_type_id")
  // Observação livre opcional (ex.: nome do freelancer).
  description   String?
  amount        Decimal  @db.Decimal(10, 2)
  createdById   Int      @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  closing     DailyClosing @relation(fields: [closingId], references: [id])
  expenseType ExpenseType  @relation(fields: [expenseTypeId], references: [id])
  createdBy   User         @relation(fields: [createdById], references: [id])

  @@index([closingId])
  @@index([expenseTypeId])
  @@map("expenses")
}

/// Insumo do estoque (Entregável 2): hambúrguer, refrigerante, queijo... Contado sempre na
/// mesma unidade (`countUnit`, texto livre: "un", "kg", "bandeja"); compras podem vir em
/// embalagens com conversão fixa (`SupplyPackage`). Nada é apagado: sai de uso com `active`.
model Supply {
  id           Int      @id @default(autoincrement())
  name         String
  // Mesma normalização do bairro (minúsculas, sem acento) para unicidade.
  nameKey      String   @unique @map("name_key")
  countUnit    String   @map("count_unit")
  // Abaixo disso o insumo aparece como crítico; nulo = sem alerta. Na unidade de contagem.
  minStock     Decimal? @map("min_stock") @db.Decimal(10, 3)
  // Custo em R$ por unidade de contagem, base do CMV dos lanches; nulo = sem custo.
  // 4 casas: R$ 39,90/kg usado em porções de 0,036 kg precisa de precisão abaixo do centavo.
  unitCost     Decimal? @map("unit_cost") @db.Decimal(10, 4)
  // Falso = a venda não desconta do estoque (tomate, queijo peça); só a contagem mexe nele.
  deductOnSale Boolean  @default(true) @map("deduct_on_sale")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  packages   SupplyPackage[]
  lots       StockLot[]
  movements  StockMovement[]
  counts     StockCount[]
  components ProductComponent[]

  @@map("supplies")
}

/// Embalagem de compra de um insumo: "caixa" = 36 (unidades de contagem do insumo).
/// A conversão é aplicada na entrada do estoque; lotes guardam a quantidade já convertida,
/// então trocar as embalagens não altera entradas antigas.
model SupplyPackage {
  id       Int     @id @default(autoincrement())
  supplyId Int     @map("supply_id")
  name     String
  quantity Decimal @db.Decimal(10, 3)

  supply Supply @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  @@unique([supplyId, name])
  @@map("supply_packages")
}

enum StockMovementKind {
  ENTRY
  COUNT
}

enum StockCountStatus {
  COUNTED
  NOT_COUNTED
  NEEDS_PURCHASE
}

/// Lote de um insumo: cada entrada vira um lote com validade própria (dois fardos com
/// validades diferentes = dois lotes). `remaining` é o saldo atual, já na unidade de contagem.
model StockLot {
  id          Int       @id @default(autoincrement())
  supplyId    Int       @map("supply_id")
  quantity    Decimal   @db.Decimal(10, 3)
  remaining   Decimal   @db.Decimal(10, 3)
  // Nulo: sem validade (sacola) ou sobra achada na contagem; é descontado por último.
  expiresOn   DateTime? @map("expires_on") @db.Date
  createdById Int       @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  supply    Supply          @relation(fields: [supplyId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])
  movements StockMovement[]

  @@index([supplyId])
  @@map("stock_lots")
}

/// Histórico de tudo que mexe no saldo de um lote (quantidade com sinal). Hoje: entrada e
/// ajuste da contagem por sobrescrita; no Entregável 3 entra a baixa por venda.
model StockMovement {
  id          Int               @id @default(autoincrement())
  supplyId    Int               @map("supply_id")
  lotId       Int               @map("lot_id")
  kind        StockMovementKind
  quantity    Decimal           @db.Decimal(10, 3)
  createdById Int               @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  supply    Supply   @relation(fields: [supplyId], references: [id])
  lot       StockLot @relation(fields: [lotId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([supplyId])
  @@map("stock_movements")
}

/// Resultado da contagem de um insumo. `quantity` só existe em COUNTED; NOT_COUNTED
/// (ex.: fatias de presunto) e NEEDS_PURCHASE (ex.: calabresa congelada) não mexem no saldo.
model StockCount {
  id          Int              @id @default(autoincrement())
  supplyId    Int              @map("supply_id")
  status      StockCountStatus
  quantity    Decimal?         @db.Decimal(10, 3)
  createdById Int              @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  supply    Supply @relation(fields: [supplyId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([supplyId, createdAt])
  @@map("stock_counts")
}

/// Categoria do cardápio (Tradicional, Artesanal, Adicionais). O mesmo nome de lanche pode
/// existir em categorias diferentes ("X Salada" tradicional e artesanal).
model ProductCategory {
  id        Int     @id @default(autoincrement())
  name      String
  // Mesma normalização do bairro (minúsculas, sem acento) para unicidade.
  nameKey   String  @unique @map("name_key")
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  products Product[]

  @@map("product_categories")
}

/// Item do cardápio. A composição (insumos e quantidades) dá o CMV, calculado na leitura
/// a partir do custo atual dos insumos. Ainda não é usado no pedido do caixa (Entregável 3).
model Product {
  id           Int      @id @default(autoincrement())
  categoryId   Int      @map("category_id")
  name         String
  nameKey      String   @map("name_key")
  description  String?
  // Número do cardápio impresso (9 = X Salada). Tradicional e artesanal de mesmo nome
  // dividem o número, então não é único; adicionais não têm.
  menuNumber   Int?     @map("menu_number")
  // Nulo = ainda sem preço (ex.: item novo cadastrado antes de precificar).
  salePrice    Decimal? @map("sale_price") @db.Decimal(10, 2)
  // Planilha de onde veio ('cardapio', 'bebidas'); nulo = cadastrado à mão. A reimportação
  // só desativa o que veio da mesma planilha, nunca um item cadastrado à mão.
  importSource String?  @map("import_source")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category   ProductCategory    @relation(fields: [categoryId], references: [id])
  components ProductComponent[]

  @@unique([categoryId, nameKey])
  @@map("products")
}

/// Quanto de um insumo vai em um produto, na unidade de contagem do insumo
/// (X Salada: 0,036 kg de queijo bandeja, 1 un de hambúrguer 56g).
model ProductComponent {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  supplyId  Int     @map("supply_id")
  quantity  Decimal @db.Decimal(10, 3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  supply  Supply  @relation(fields: [supplyId], references: [id])

  @@unique([productId, supplyId])
  @@map("product_components")
}
