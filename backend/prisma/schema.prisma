// Modelo do Sprint 1 (fechamento de caixa diário). Ver docs/banco-de-dados.md.
// CHECK constraints (Prisma não expressa) ficam em SQL na migration:
//   - orders: type = 'COUNTER' => delivery_zone_id IS NULL AND delivery_fee = 0

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CAIXA
  ADMIN
}

enum OrderType {
  DELIVERY
  COUNTER
}

/// Entrega: Em preparo → Saiu → Entregue. Balcão: Em preparo → Entregue.
enum OrderStatus {
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
}

// Meio usado na maquininha (pedido do usuário, 2026-10-07): só em formas com `isCardTerminal`.
enum PaymentMode {
  CREDIT
  DEBIT
  PIX
}

enum ClosingStatus {
  OPEN
  CLOSED
}

enum DayGroup {
  TUE_THU
  FRI_SUN
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  closedClosings   DailyClosing[]       @relation("ClosedBy")
  reopenedClosings DailyClosing[]       @relation("ReopenedBy")
  orders           Order[]
  expenses         Expense[]
  rateSettings     MotoboyRateSetting[]
  stockLots        StockLot[]
  stockMovements   StockMovement[]
  stockCounts      StockCount[]

  @@map("users")
}

model PaymentMethod {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  active         Boolean  @default(true)
  sortOrder      Int      @default(0) @map("sort_order")
  // Maquininha (Tom, PagBank): o pedido diz o meio usado nela (crédito, débito ou PIX).
  isCardTerminal Boolean  @default(false) @map("is_card_terminal")
  // Dinheiro: a entrega paga nela pode levar o "Troco para" (2026-10-10).
  isCash         Boolean  @default(false) @map("is_cash")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("payment_methods")
}

model DeliveryZone {
  id              Int      @id @default(autoincrement())
  neighborhood    String
  // Chave normalizada (minúsculas, sem acento) gerada pela aplicação, para unicidade.
  neighborhoodKey String   @unique @map("neighborhood_key")
  fee             Decimal  @db.Decimal(10, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  orders    Order[]
  customers Customer[]

  @@map("delivery_zones")
}

model MotoboyRateSetting {
  id            Int      @id @default(autoincrement())
  dayGroup      DayGroup @map("day_group")
  amount        Decimal  @db.Decimal(10, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdById   Int      @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@unique([dayGroup, effectiveFrom])
  @@map("motoboy_rate_settings")
}

model DailyClosing {
  id               Int           @id @default(autoincrement())
  businessDate     DateTime      @unique @map("business_date") @db.Date
  status           ClosingStatus @default(OPEN)
  // Último número de pedido dado no dia: só cresce, então apagar o último pedido não faz o
  // próximo repetir o número dele (a comanda impressa já saiu com ele).
  lastOrderNumber  Int           @default(0) @map("last_order_number")
  // Diária copiada na criação: editar a config depois não altera dias antigos.
  motoboyDailyRate Decimal       @map("motoboy_daily_rate") @db.Decimal(10, 2)
  closedById       Int?          @map("closed_by_id")
  closedAt         DateTime?     @map("closed_at") @db.Timestamptz
  reopenedById     Int?          @map("reopened_by_id")
  reopenedAt       DateTime?     @map("reopened_at") @db.Timestamptz
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  closedBy   User?     @relation("ClosedBy", fields: [closedById], references: [id])
  reopenedBy User?     @relation("ReopenedBy", fields: [reopenedById], references: [id])
  orders     Order[]
  expenses   Expense[]

  @@map("daily_closings")
}

model Order {
  id                Int          @id @default(autoincrement())
  closingId         Int          @map("closing_id")
  amount            Decimal      @db.Decimal(10, 2)
  // `type`, `paymentMethodId` e `deliveryFee` são nulos só em pedidos importados da planilha
  // histórica (ticket-medio-2026), que não registrava essa distinção. A aplicação sempre os preenche,
  // menos o `paymentMethodId` da conta aberta no balcão (paga no fim; 2026-10-10).
  type              OrderType?
  paymentMethodId   Int?         @map("payment_method_id")
  // Preenchido só quando a forma é maquininha (a aplicação garante).
  paymentMode       PaymentMode? @map("payment_mode")
  deliveryZoneId    Int?         @map("delivery_zone_id")
  // Cópia da taxa da zona no lançamento; pode ser sobrescrita. 0 para balcão.
  deliveryFee       Decimal?     @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  // "Troco para" da entrega paga em dinheiro (o motoboy leva a diferença).
  changeFor         Decimal?     @map("change_for") @db.Decimal(10, 2)
  // Cliente da entrega (obrigatório na aplicação só para DELIVERY). Nome, telefone e rua são
  // copiados no lançamento: mudar o cadastro do cliente não altera pedidos antigos.
  customerId        Int?         @map("customer_id")
  customerName      String?      @map("customer_name")
  customerPhone     String?      @map("customer_phone")
  customerStreet    String?      @map("customer_street")
  customerNumber    String?      @map("customer_number")
  customerReference String?      @map("customer_reference")
  // Número do pedido no dia (#1, #2…): sequência por fechamento, fixa (apagar o #3 deixa
  // #1, #2, #4). Vem do contador `daily_closings.last_order_number`.
  dayNumber         Int          @map("day_number")
  // Andamento (2026-10-10): nasce Em preparo na noite em andamento; fechar o dia conclui.
  status            OrderStatus  @default(DELIVERED)
  createdById       Int          @map("created_by_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  closing       DailyClosing    @relation(fields: [closingId], references: [id])
  paymentMethod PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])
  deliveryZone  DeliveryZone?   @relation(fields: [deliveryZoneId], references: [id])
  customer      Customer?       @relation(fields: [customerId], references: [id])
  createdBy     User            @relation(fields: [createdById], references: [id])
  items         OrderItem[]
  stockMoves    StockMovement[]
  oversales     StockOversale[]

  @@unique([closingId, dayNumber])
  @@index([closingId])
  @@index([paymentMethodId])
  @@index([customerId])
  @@map("orders")
}

/// Cliente de entrega. Um telefone = um cadastro (e uma rua); telefone é opcional
/// porque o pedido no papel às vezes não traz o número.
model Customer {
  id             Int      @id @default(autoincrement())
  name           String
  // Nome normalizado (minúsculas, sem acento) gerado pela aplicação: o caixa acha o cliente
  // pelo nome quando não tem o telefone. Não é único (dois "João" podem existir).
  nameKey        String   @map("name_key")
  // Só dígitos (ex.: "79999991234"); único quando presente.
  phone          String?  @unique
  street         String
  // Número da casa ("S/N" sem número) e referência livre, para a comanda impressa que vai ao
  // motoboy (pedido do usuário, 2026-10-08). Nulos nos clientes cadastrados antes disso.
  number         String?
  reference      String?
  deliveryZoneId Int      @map("delivery_zone_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  deliveryZone DeliveryZone @relation(fields: [deliveryZoneId], references: [id])
  orders       Order[]

  @@index([nameKey])
  @@map("customers")
}

// Tipo de gasto parametrizável ("Gás", "Compra no Atacadão"...). Nada é apagado: `active: false`.
model ExpenseType {
  id        Int      @id @default(autoincrement())
  name      String
  // Mesma normalização do bairro (minúsculas, sem acento) para unicidade.
  nameKey   String   @unique @map("name_key")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@map("expense_types")
}

model Expense {
  id            Int      @id @default(autoincrement())
  closingId     Int      @map("closing_id")
  expenseTypeId Int      @map("expense_type_id")
  // Observação livre opcional (ex.: nome do freelancer).
  description   String?
  amount        Decimal  @db.Decimal(10, 2)
  createdById   Int      @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  closing     DailyClosing @relation(fields: [closingId], references: [id])
  expenseType ExpenseType  @relation(fields: [expenseTypeId], references: [id])
  createdBy   User         @relation(fields: [createdById], references: [id])

  @@index([closingId])
  @@index([expenseTypeId])
  @@map("expenses")
}

/// Insumo do estoque (Entregável 2): hambúrguer, refrigerante, queijo... Contado sempre na
/// mesma unidade (`countUnit`, texto livre: "un", "kg", "bandeja"); compras podem vir em
/// embalagens com conversão fixa (`SupplyPackage`). Nada é apagado: sai de uso com `active`.
model Supply {
  id           Int      @id @default(autoincrement())
  name         String
  // Mesma normalização do bairro (minúsculas, sem acento) para unicidade.
  nameKey      String   @unique @map("name_key")
  countUnit    String   @map("count_unit")
  // Abaixo disso o insumo aparece como crítico; nulo = sem alerta. Na unidade de contagem.
  minStock     Decimal? @map("min_stock") @db.Decimal(10, 3)
  // Custo em R$ por unidade de contagem, base do CMV dos lanches; nulo = sem custo.
  // 4 casas: R$ 39,90/kg usado em porções de 0,036 kg precisa de precisão abaixo do centavo.
  unitCost     Decimal? @map("unit_cost") @db.Decimal(10, 4)
  // Falso = a venda não desconta do estoque (tomate, alface); só a contagem mexe nele.
  deductOnSale Boolean  @default(true) @map("deduct_on_sale")
  // Contar todo dia (alface, tomate...): a Situação avisa enquanto não houver contagem hoje.
  dailyCount   Boolean  @default(false) @map("daily_count")
  // Lugar do insumo na lanchonete (Geladeira, Armário...); nulo = "Sem seção".
  sectionId    Int?     @map("section_id")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  section    SupplySection?     @relation(fields: [sectionId], references: [id])
  packages   SupplyPackage[]
  lots       StockLot[]
  movements  StockMovement[]
  counts     StockCount[]
  oversales  StockOversale[]
  components ProductComponent[]

  @@map("supplies")
}

/// Seção do estoque, na ordem da prateleira: filtra e agrupa insumos, entrada e contagem.
model SupplySection {
  id        Int     @id @default(autoincrement())
  name      String
  // Mesma normalização do bairro (minúsculas, sem acento) para unicidade.
  nameKey   String  @unique @map("name_key")
  sortOrder Int     @default(0) @map("sort_order")
  active    Boolean @default(true)

  supplies Supply[]

  @@map("supply_sections")
}

/// Embalagem de compra de um insumo: "caixa" = 36 (unidades de contagem do insumo).
/// A conversão é aplicada na entrada do estoque; lotes guardam a quantidade já convertida,
/// então trocar as embalagens não altera entradas antigas.
model SupplyPackage {
  id       Int     @id @default(autoincrement())
  supplyId Int     @map("supply_id")
  name     String
  quantity Decimal @db.Decimal(10, 3)

  supply Supply @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  @@unique([supplyId, name])
  @@map("supply_packages")
}

enum StockMovementKind {
  ENTRY
  COUNT
  // Estorno de uma entrada lançada errado (sessão 8): zera o lote ainda intacto.
  REVERSAL
  // Baixa de um pedido do dia (bebidas, 2026-10-09) e a devolução quando ele é editado/apagado.
  SALE
  SALE_RETURN
}

enum StockCountStatus {
  COUNTED
  NOT_COUNTED
  NEEDS_PURCHASE
}

/// Lote de um insumo: cada entrada vira um lote com validade própria (dois fardos com
/// validades diferentes = dois lotes). `remaining` é o saldo atual, já na unidade de contagem.
model StockLot {
  id          Int       @id @default(autoincrement())
  supplyId    Int       @map("supply_id")
  quantity    Decimal   @db.Decimal(10, 3)
  remaining   Decimal   @db.Decimal(10, 3)
  // Nulo: sem validade (sacola) ou sobra achada na contagem; é descontado por último.
  expiresOn   DateTime? @map("expires_on") @db.Date
  // Custo pago por unidade de contagem nesta entrada; nulo = não informado (ou sobra da contagem).
  unitCost    Decimal?  @map("unit_cost") @db.Decimal(10, 4)
  // Preenchido quando a entrada foi estornada; o lote fica com saldo zero.
  reversedAt  DateTime? @map("reversed_at")
  createdById Int       @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  supply    Supply          @relation(fields: [supplyId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])
  movements StockMovement[]

  @@index([supplyId])
  @@map("stock_lots")
}

/// Histórico de tudo que mexe no saldo de um lote (quantidade com sinal). Hoje: entrada e
/// ajuste da contagem por sobrescrita; no Entregável 3 entra a baixa por venda.
model StockMovement {
  id          Int               @id @default(autoincrement())
  supplyId    Int               @map("supply_id")
  lotId       Int               @map("lot_id")
  kind        StockMovementKind
  quantity    Decimal           @db.Decimal(10, 3)
  // Pedido da baixa (SALE/SALE_RETURN); nulo nos outros movimentos e depois que o pedido é apagado.
  orderId     Int?              @map("order_id")
  createdById Int               @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  supply    Supply   @relation(fields: [supplyId], references: [id])
  lot       StockLot @relation(fields: [lotId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([supplyId])
  @@index([orderId])
  @@map("stock_movements")
}

/// Resultado da contagem de um insumo. `quantity` só existe em COUNTED; NOT_COUNTED
/// (ex.: fatias de presunto) e NEEDS_PURCHASE (ex.: calabresa congelada) não mexem no saldo.
model StockCount {
  id          Int              @id @default(autoincrement())
  supplyId    Int              @map("supply_id")
  status      StockCountStatus
  quantity    Decimal?         @db.Decimal(10, 3)
  createdById Int              @map("created_by_id")
  createdAt   DateTime         @default(now()) @map("created_at")

  supply    Supply @relation(fields: [supplyId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([supplyId, createdAt])
  @@map("stock_counts")
}

/// Categoria do cardápio (Tradicional, Artesanal, Adicionais). O mesmo nome de lanche pode
/// existir em categorias diferentes ("X Salada" tradicional e artesanal).
model ProductCategory {
  id              Int     @id @default(autoincrement())
  name            String
  // Mesma normalização do bairro (minúsculas, sem acento) para unicidade.
  nameKey         String  @unique @map("name_key")
  sortOrder       Int     @default(0) @map("sort_order")
  active          Boolean @default(true)
  // Categoria cujos produtos podem entrar como adicionais dos itens desta (2026-10-09:
  // Tradicional e Artesanal → Adicionais; Açaí → Adicionais do açaí). Um nível só.
  addonCategoryId Int?    @map("addon_category_id")

  products      Product[]
  addonCategory ProductCategory?  @relation("CategoryAddons", fields: [addonCategoryId], references: [id], onDelete: SetNull)
  addonFor      ProductCategory[] @relation("CategoryAddons")

  @@map("product_categories")
}

/// Item do cardápio. A composição (insumos e quantidades) dá o CMV, calculado na leitura
/// a partir do custo atual dos insumos; o pedido copia preço e CMV no lançamento (OrderItem).
model Product {
  id            Int       @id @default(autoincrement())
  categoryId    Int       @map("category_id")
  name          String
  nameKey       String    @map("name_key")
  description   String?
  // Número do cardápio impresso (9 = X Salada). Tradicional e artesanal de mesmo nome
  // dividem o número, então não é único; adicionais não têm.
  menuNumber    Int?      @map("menu_number")
  // Nulo = ainda sem preço (ex.: item novo cadastrado antes de precificar).
  salePrice     Decimal?  @map("sale_price") @db.Decimal(10, 2)
  // Planilha de onde veio ('cardapio', 'bebidas'); nulo = cadastrado à mão. A reimportação
  // só desativa o que veio da mesma planilha, nunca um item cadastrado à mão.
  importSource  String?   @map("import_source")
  active        Boolean   @default(true)
  // Dia de negócio em que saiu do cardápio: um caixa atrasado de antes disso ainda vende o item.
  // Nulo se ativo ou se saiu antes do histórico de preços (2026-10-09).
  deactivatedOn DateTime? @map("deactivated_on") @db.Date
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  category     ProductCategory       @relation(fields: [categoryId], references: [id])
  components   ProductComponent[]
  orderItems   OrderItem[]
  priceHistory ProductPriceHistory[]
  // Combo (pedido do usuário, 2026-10-09): os itens fixos dele; vazio = produto comum.
  bundleItems  ProductBundleItem[]   @relation("BundleItems")
  // Combos em que este produto entra.
  bundledIn    ProductBundleItem[]   @relation("BundledIn")

  @@unique([categoryId, nameKey])
  @@map("products")
}

/// Item fixo de um combo ("1 X Salada + 1 Guaraná lata" a R$ 19,00). O combo não tem insumos
/// próprios: CMV e baixa no estoque saem da composição dos itens. Um nível só (item não é combo).
model ProductBundleItem {
  id              Int @id @default(autoincrement())
  bundleProductId Int @map("bundle_product_id")
  itemProductId   Int @map("item_product_id")
  // De 1 a 99 (CHECK no banco).
  quantity        Int

  bundle Product @relation("BundleItems", fields: [bundleProductId], references: [id], onDelete: Cascade)
  item   Product @relation("BundledIn", fields: [itemProductId], references: [id])

  @@unique([bundleProductId, itemProductId])
  @@index([itemProductId])
  @@map("product_bundle_items")
}

/// Preços que deixaram de valer (reajuste do cardápio, 2026-10-10). O preço atual fica em
/// `products.sale_price`; o preço num dia D é o desta tabela com o menor `valid_until` >= D,
/// ou o atual se não houver. Várias trocas no mesmo dia guardam só o preço original.
model ProductPriceHistory {
  id         Int      @id @default(autoincrement())
  productId  Int      @map("product_id")
  salePrice  Decimal  @map("sale_price") @db.Decimal(10, 2)
  // Último dia de negócio (inclusivo) em que o preço valeu.
  validUntil DateTime @map("valid_until") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, validUntil])
  @@map("product_price_history")
}

/// Quanto de um insumo vai em um produto, na unidade de contagem do insumo
/// (X Salada: 0,036 kg de queijo bandeja, 1 un de hambúrguer 56g).
model ProductComponent {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  supplyId  Int     @map("supply_id")
  quantity  Decimal @db.Decimal(10, 3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  supply  Supply  @relation(fields: [supplyId], references: [id])

  @@unique([productId, supplyId])
  @@map("product_components")
}

/// Linha do pedido (Entregável 3). Nome, número e categoria são cópias, e preço e CMV são os da
/// época do lançamento: mudar o cardápio ou o custo dos insumos não altera pedido antigo.
model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  productId    Int      @map("product_id")
  productName  String   @map("product_name")
  menuNumber   Int?     @map("menu_number")
  categoryName String   @map("category_name")
  // De 1 a 99 (CHECK no banco).
  quantity     Int
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  // Nulo = produto sem composição; `cmvComplete` falso = faltou custo de algum insumo.
  unitCmv      Decimal? @map("unit_cmv") @db.Decimal(10, 2)
  cmvComplete  Boolean  @default(false) @map("cmv_complete")
  // Adicional preso ao item (2026-10-09): a linha filha guarda o total (por unidade × a do item).
  parentItemId Int?     @map("parent_item_id")
  // Observação do item para a comanda ("sem tomate"); adicional não tem (CHECK no banco).
  note         String?  @db.VarChar(120)

  order   Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product     @relation(fields: [productId], references: [id])
  parent  OrderItem?  @relation("OrderItemAddons", fields: [parentItemId], references: [id], onDelete: Cascade)
  addons  OrderItem[] @relation("OrderItemAddons")

  @@index([orderId])
  @@index([parentItemId])
  @@index([productId])
  @@map("order_items")
}

/// Venda além do saldo do sistema (bebida vendida com o estoque do sistema zerado, 2026-10-09):
/// fica "Conferir" na Situação; a próxima entrada desconta (vira baixa do pedido no lote novo) e
/// a contagem zera (ela já mostra o real).
model StockOversale {
  id        Int      @id @default(autoincrement())
  supplyId  Int      @map("supply_id")
  // Pedido que vendeu além; nulo se ele foi apagado depois (caixa atrasado não devolve).
  orderId   Int?     @map("order_id")
  // O que falta descontar, na unidade de contagem (> 0).
  quantity  Decimal  @db.Decimal(10, 3)
  createdAt DateTime @default(now()) @map("created_at")

  supply Supply @relation(fields: [supplyId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([supplyId])
  @@index([orderId])
  @@map("stock_oversales")
}

/// Opções que o dono muda pela tela (chave → valor em texto, lido com tipo no código).
/// `low_stock_warning`: o caixa mostra o saldo da bebida abaixo deste número (0 = nunca).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
